{
  "name": "envkey-vscode",
  "displayName": "envkey-vscode",
  "description": "Autocomplete and type checking for environment variables across every language you work in.",
  "version": "2.5.4",
  "publisher": "EnvKey",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#222222",
    "theme": "dark"
  },
  "homepage": "https://envkey.com/integrations/vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/envkey/envkey.git"
  },
  "bugs": {
    "url": "https://github.com/envkey/envkey/issues",
    "email": "support@envkey.com"
  },
  "engines": {
    "vscode": "^1.78.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "environment variables",
    "secrets management",
    "security",
    "dotenv",
    "encryption"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": []
  },
  "scripts": {
    "vscode:prepublish": "pnpm install && pnpm run package",
    "build": "webpack --mode production --devtool hidden-source-map",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^18.18.0",
    "@types/vscode": "^1.78.0",
    "@types/webpack": "^5.28.1",
    "copy-webpack-plugin": "^11.0.0",
    "glob": "^8.1.0",
    "rimraf": "^5.0.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "envkey": "workspace:^2.5.1"
  }
}
