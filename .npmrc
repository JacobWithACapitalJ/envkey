# Rush.js pnpm configuration

# Use hoisted node_modules for Electron/native module compatibility
node-linker=hoisted
shamefully-hoist=true

# Hoist patterns for native modules
public-hoist-pattern[]=*keytar*
public-hoist-pattern[]=*electron*
public-hoist-pattern[]=@types/*

# Strict peer dependencies can cause issues during migration
strict-peer-dependencies=false

# Allow running scripts during install
enable-pre-post-scripts=true

# Electron mirror for faster downloads
electron_mirror=https://github.com/electron/electron/releases/download/

# Registry
registry=https://registry.npmjs.org/
