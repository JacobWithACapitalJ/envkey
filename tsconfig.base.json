{
  "compilerOptions": {
    "lib": ["es2019", "dom"],
    "target": "es6",
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "incremental": true,
    "resolveJsonModule": true,
  },
  "exclude": ["**/node_modules", "**/build", "**/dist", "**/.*/"],
}
