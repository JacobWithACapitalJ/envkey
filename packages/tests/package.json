{
  "name": "@envkey/tests",
  "version": "2.0.0",
  "description": "EnvKey client/server tests",
  "author": "Envkey Inc",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "echo 'Test package - no build needed'",
    "check": "tsc --noEmit -p tsconfig.json",
    "check-watch": "tsc --watch --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS='--stack-trace-limit=100' NODE_TLS_REJECT_UNAUTHORIZED=0 REENCRYPTION_MIN_DELAY=200 REENCRYPTION_JITTER=0 jest --notify --no-watchman --runInBand --forceExit",
    "test-ci": "NODE_TLS_REJECT_UNAUTHORIZED=0 REENCRYPTION_MIN_DELAY=200 REENCRYPTION_JITTER=0 jest --reporters=default --reporters=jest-junit --runInBand --forceExit --detectOpenHandles",
    "test-inspect": "NODE_TLS_REJECT_UNAUTHORIZED=0 REENCRYPTION_MIN_DELAY=200 REENCRYPTION_JITTER=0 node --inspect=9229 ./node_modules/.bin/jest --notify --runInBand --no-watchman"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.18.0",
    "@types/supertest": "^2.0.10",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^6.1.3",
    "ts-jest": "^29.1.0",
    "typescript": "~5.3.3"
  },
  "dependencies": {
    "@envkey/core": "workspace:*",
    "@envkey/infra": "workspace:*",
    "@envkey/client-core-process": "workspace:*",
    "@envkey/api-express": "workspace:*"
  }
}
