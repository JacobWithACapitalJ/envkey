{
  "name": "@envkey/api-express",
  "version": "2.3.6",
  "description": "EnvKey self-hosted community API",
  "author": "Envkey Inc",
  "license": "MIT",
  "private": true,
  "main": "build/api.community.js",
  "scripts": {
    "start": "nodemon --config ./nodemon.community.json",
    "build": "webpack --config webpack.config.ts",
    "watch": "webpack --config webpack.config.ts --watch",
    "check": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf build",
    "db:migrate": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/db_migrate.ts",
    "db:migrate:down": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/db_migrate_down.ts",
    "db:migrate:unlock": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/db_migrate_unlock.ts"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.1",
    "@types/express": "^4.17.9",
    "@types/marked": "^4.0.2",
    "@types/memoizee": "^0.4.5",
    "@types/node": "^18.18.0",
    "@types/node-fetch": "^2.5.7",
    "@types/nodemailer": "^6.4.0",
    "@types/ramda": "^0.27.32",
    "@types/semver": "^7.3.4",
    "@types/uuid": "^8.3.0",
    "@types/workerpool": "^6.0.0",
    "@types/ws": "^7.4.0",
    "nodemon": "^2.0.6",
    "rimraf": "^5.0.5",
    "terser-webpack-plugin": "^5.3.9",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "~5.3.3",
    "webpack": "^5.89.0",
    "webpack-build-notifier": "^2.3.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@envkey/core": "workspace:*",
    "@envkey/infra": "workspace:*",
    "aws-sdk": "^2.934.0",
    "bs58": "^4.0.1",
    "fast-json-stable-stringify": "^2.1.0",
    "rfc6902": "^4.0.1",
    "semver": "^7.3.2",
    "body-parser": "^1.19.0",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-async-handler": "^1.1.4",
    "immer": "^9.0.7",
    "knex": "^0.21.12",
    "marked": "^4.0.12",
    "marked-plaintext": "^0.0.2",
    "memoizee": "^0.4.15",
    "moment": "^2.29.4",
    "mysql2": "^2.2.5",
    "node-fetch": "^2.6.1",
    "nodemailer": "^6.4.16",
    "ramda": "^0.27.1",
    "source-map-support": "^0.5.21",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^8.3.1",
    "workerpool": "^6.0.3",
    "ws": "^7.5.6"
  }
}
