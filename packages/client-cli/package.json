{
  "name": "@envkey/client-cli",
  "version": "2.5.0",
  "description": "EnvKey CLI - dispatches actions and retrieves state from core_process server",
  "author": "Envkey Inc",
  "license": "MIT",
  "private": true,
  "main": "build/envkey-cli.js",
  "bin": {
    "envkey": "build/envkey-cli.js"
  },
  "scripts": {
    "start": "NODE_ENV=development node -r ts-node/register/transpile-only -r tsconfig-paths/register src/index.ts",
    "start-core": "nodemon --config nodemon_core_proc.json",
    "core-process": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/cli_core_proc.ts",
    "build": "webpack --config webpack.cli.ts",
    "build-check": "WEBPACK_OUTPUT_DIR=$(pwd)/build/ webpack --config webpack.cli.ts && node build/envkey-cli.js -h",
    "watch": "webpack --config webpack.cli.ts --watch",
    "check": "tsc --noEmit -p tsconfig.json",
    "check-watch": "tsc --watch --noEmit -p tsconfig.json",
    "clean": "rimraf build"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.0",
    "@types/fs-extra": "^9.0.13",
    "@types/humps": "^2.0.1",
    "@types/lodash": "^4.14.178",
    "@types/node": "^18.18.0",
    "@types/ramda": "^0.27.32",
    "@types/semver": "^7.3.4",
    "@types/yargs": "^16.0.4",
    "native-ext-loader": "^2.3.0",
    "nodemon": "^2.0.6",
    "rimraf": "^5.0.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "~5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@envkey/core": "workspace:*",
    "@envkey/client-core-process": "workspace:*",
    "@envkey/infra": "workspace:*",
    "archiver": "^5.3.0",
    "chalk": "^4.1.0",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.0",
    "dotenv": "^8.2.0",
    "enquirer": "^2.3.6",
    "form-data": "^4.0.0",
    "fs-extra": "^10.0.0",
    "got": "^11.8.3",
    "humps": "^2.0.1",
    "keytar": "^7.9.0",
    "lodash": "^4.17.21",
    "marked": "^4.0.12",
    "marked-terminal": "^4.1.0",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.34",
    "ora": "^5.1.0",
    "ramda": "^0.27.1",
    "semver": "^7.3.2",
    "source-map-support": "^0.5.21",
    "strip-ansi": "^6.0.0",
    "yargs": "^15.4.1",
    "yargs-parser": "^20.2.7",
    "zod": "^1.11.10"
  }
}
