{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "outDir": "dist",
    "types": ["node"],
    "paths": {
      "@core/*": ["../core/src/*"],
      "@envkey/core/*": ["../core/src/*"],
      "@core_proc/*": ["../client-core-process/src/*"],
      "@envkey/client-core-process/*": ["../client-core-process/src/*"],
      "@infra/*": ["../infra/src/*"],
      "@envkey/infra/*": ["../infra/src/*"],
    },
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "build"],
}
