      "packageName": "@envkey/core",
      "projectFolder": "packages/core",
      "reviewCategory": "libraries",
      "shouldPublish": false,
      "tags": ["core", "typescript-only"]
    },
    {
      "packageName": "@envkey/infra",
      "projectFolder": "packages/infra",
      "reviewCategory": "libraries",
      "shouldPublish": false,
      "tags": ["core", "aws"]
    },
    {
      "packageName": "@envkey/api-express",
      "projectFolder": "packages/api-express",
      "reviewCategory": "applications",
      "shouldPublish": false,
      "tags": ["api", "webpack"]
    },
    {
