{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/rush.schema.json",
  "rushVersion": "5.166.0",
  "pnpmVersion": "9.15.4",
  "nodeSupportedVersionRange": ">=16.14.0",
  "ensureConsistentVersions": true,
  "projectFolderMinDepth": 2,
  "projectFolderMaxDepth": 4,

  "repository": {
    "url": "https://github.com/envkey/envkey.git",
    "defaultBranch": "main",
    "defaultRemote": "origin"
  },

  "eventHooks": {
    "preRushInstall": [],
    "postRushInstall": []
  },

  "projects": [
